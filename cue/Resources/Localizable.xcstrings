        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットアプリの「オートメーション」を使えば、ライブを中断なく使い続けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“快捷指令”App 的“自动化”，让实时活动持续运行不中断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「捷徑」App 的「自動化操作」，讓即時動態持續運行不中斷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la ‘Automatización’ de la app Atajos para mantener tu Live sin interrupciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a ‘Automação’ do app Atalhos para manter seu Live sem interrupções."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'‘Automazione’ dell'app Comandi Rapidi per mantenere il tuo Live senza interruzioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die „Automation“ der Kurzbefehle-App, damit dein Live ohne Unterbrechung läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'« Automatisation » de l'app Raccourcis pour que votre Live fonctionne sans interruption."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте «Автоматизацию» в приложении «Быстрые команды», чтобы Live работал без перерывов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم ‘الأتمتة’ في تطبيق الاختصارات لإبقاء اللايف يعمل دون انقطاع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लाइव को बिना रुकावट चालू रखने के लिए शॉर्टकट ऐप के ‘ऑटोमेशन’ का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan ‘Otomasi’ di aplikasi Pintasan agar Live tetap berjalan tanpa henti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna ‘Automasi’ dalam aplikasi Pintasan supaya Live terus berjalan tanpa gangguan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ ‘ระบบอัตโนมัติ’ ในแอปทางลัดเพื่อให้ Live ทำงานต่อเนื่องไม่สะดุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ‘Tự động hóa’ trong ứng dụng Phím tắt để Live chạy liên tục không gián đoạn."
          }
        }
      }
    },
