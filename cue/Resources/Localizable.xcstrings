    "Repeat twice more to create three automations running 8 hours apart. e.g. 00:00, 08:00, 16:00": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 과정을 두 번 더 반복하여 8시간 간격으로 실행되는 3개의 자동화를 만듭니다. 예) 00:00, 08:00, 16:00"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ手順をあと2回繰り返し、8時間間隔で実行される3つのオートメーションを作成します。例）00:00、08:00、16:00"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再重复两次，创建 3 个每隔 8 小时运行的自动化。例如 00:00、08:00、16:00"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再重複兩次，建立 3 個每隔 8 小時執行的自動化操作。例如 00:00、08:00、16:00"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite dos veces más para crear tres automatizaciones que se ejecuten con 8 horas de diferencia. Ej.: 00:00, 08:00, 16:00"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita mais duas vezes para criar três automações executadas com 8 horas de intervalo. Ex.: 00:00, 08:00, 16:00"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti altre due volte per creare tre automazioni distanziate di 8 ore. Es.: 00:00, 08:00, 16:00"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole das zweimal, um drei Automationen im Abstand von 8 Stunden zu erstellen. Z. B. 00:00, 08:00, 16:00"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez deux fois de plus pour créer trois automatisations espacées de 8 heures. Ex. 00:00, 08:00, 16:00"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите ещё дважды, чтобы создать три автоматизации с интервалом 8 часов. Напр., 00:00, 08:00, 16:00"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر العملية مرتين أخريين لإنشاء ثلاث أتمتات تعمل بفارق 8 ساعات. مثال: 00:00، 08:00، 16:00"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "8 घंटे के अंतर पर चलने वाले तीन ऑटोमेशन बनाने के लिए इसे दो बार और दोहराएं। जैसे 00:00, 08:00, 16:00"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi dua kali lagi untuk membuat tiga otomasi yang berjalan dengan jarak 8 jam. mis. 00:00, 08:00, 16:00"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulang dua kali lagi untuk mencipta tiga automasi yang berjalan dengan jarak 8 jam. cth. 00:00, 08:00, 16:00"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำซ้ำอีกสองครั้งเพื่อสร้างระบบอัตโนมัติสามชุดที่ทำงานห่างกัน 8 ชั่วโมง เช่น 00:00, 08:00, 16:00"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại hai lần nữa để tạo ba tự động hóa chạy cách nhau 8 giờ. VD: 00:00, 08:00, 16:00"
          }
        }
      }
    },
