          "stringUnit": {
            "state": "translated",
            "value": "Ative e atualize sem o limite de 2 por dia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva e aggiorna senza il limite di 2 al giorno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne das Limit von 2 pro Tag einschalten und aktualisieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez et actualisez sans la limite de 2 par jour"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте и обновляйте без лимита 2 раза в день"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل والتحديث دون حدّ المرتين يومياً"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिदिन 2 की सीमा के बिना चालू और रिफ़्रेश करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
