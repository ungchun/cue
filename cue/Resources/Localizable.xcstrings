        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सूची और इसमें मौजूद सभी रिमाइंडर हटा दिए जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar ini dan semua pengingat di dalamnya akan dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai ini dan semua peringatan di dalamnya akan dipadam."
