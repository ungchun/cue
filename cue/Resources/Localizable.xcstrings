    "Go to the ‘Automation’ tab in the Shortcuts app and create a new automation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 앱의 ‘자동화’ 탭으로 이동하여 새로운 자동화를 생성합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットアプリの「オートメーション」タブを開き、新しいオートメーションを作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“快捷指令”App 的“自动化”标签，新建一个自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「捷徑」App 的「自動化操作」標籤頁，並建立新的自動化操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a la pestaña ‘Automatización’ en la app Atajos y crea una nueva automatización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá até a aba ‘Automação’ no app Atalhos e crie uma nova automação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai alla scheda ‘Automazione’ nell'app Comandi Rapidi e crea una nuova automazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe in der Kurzbefehle-App zum Tab „Automation“ und erstelle eine neue Automation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans l'onglet « Automatisation » de l'app Raccourcis et créez une nouvelle automatisation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте вкладку «Автоматизация» в приложении «Быстрые команды» и создайте новую автоматизацию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى علامة التبويب ‘الأتمتة’ في تطبيق الاختصارات وأنشئ أتمتة جديدة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट ऐप में ‘ऑटोमेशन’ टैब पर जाएं और नया ऑटोमेशन बनाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tab ‘Otomasi’ di aplikasi Pintasan dan buat otomasi baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergi ke tab ‘Automasi’ dalam aplikasi Pintasan dan cipta automasi baharu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่แท็บ ‘ระบบอัตโนมัติ’ ในแอปทางลัดแล้วสร้างระบบอัตโนมัติใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào tab ‘Tự động hóa’ trong ứng dụng Phím tắt và tạo tự động hóa mới."
          }
        }
      }
    },
