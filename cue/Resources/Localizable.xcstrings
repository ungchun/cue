    "Select Cue’s ‘Refresh Live’ from the list.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 Cue의 ‘라이브 새로고침’을 선택합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストから Cue の「ライブを更新」を選択します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中选择 Cue 的“刷新实时活动”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中選擇 Cue 的「重新整理即時動態」。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona ‘Actualizar Live’ de Cue en la lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione ‘Atualizar Live’ do Cue na lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona ‘Aggiorna Live’ di Cue dall'elenco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in der Liste „Live aktualisieren“ von cue aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez « Actualiser le Live » de cue dans la liste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Обновить Live» от cue в списке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ‘تحديث اللايف’ الخاص بـ Cue من القائمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में से Cue का ‘रिफ़्रेश लाइव’ चुनें।"
