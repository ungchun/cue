    "This list and all reminders in it will be deleted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록과 안에 있는 모든 미리알림이 삭제됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストと、その中のすべてのリマインダーが削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表及其中的所有提醒事项都将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表及其中的所有提醒事項都將被刪除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán esta lista y todos sus recordatorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista e todos os lembretes nela serão excluídos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa lista e tutti i promemoria al suo interno verranno eliminati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste und alle darin enthaltenen Erinnerungen werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste et tous les rappels qu'elle contient seront supprimés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот список и все напоминания в нём будут удалены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف هذه القائمة وكل التذكيرات الموجودة فيها."
