    "Live Activities are automatically ended by the system after 8 hours — the automation turns them back on every 8 hours.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 액티비티는 시스템 정책상 8시간이 지나면 자동으로 종료됩니다 — 자동화가 8시간마다 다시 켜줍니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティはシステムの仕様により8時間で自動的に終了します。オートメーションが8時間ごとに再びオンにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动受系统限制会在 8 小时后自动结束——自动化会每 8 小时重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態受系統限制會在 8 小時後自動結束——自動化操作會每 8 小時重新開啟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema finaliza las Live Activities automáticamente tras 8 horas — la automatización las vuelve a activar cada 8 horas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Live Activities são encerradas automaticamente pelo sistema após 8 horas — a automação as reativa a cada 8 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Live Activity vengono terminate automaticamente dal sistema dopo 8 ore — l'automazione le riattiva ogni 8 ore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities werden vom System nach 8 Stunden automatisch beendet — die Automation schaltet sie alle 8 Stunden wieder ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Live Activities sont automatiquement arrêtées par le système après 8 heures — l'automatisation les réactive toutes les 8 heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity автоматически завершается системой через 8 часов — автоматизация снова включает её каждые 8 часов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي النظام أنشطة Live تلقائياً بعد 8 ساعات — تعيد الأتمتة تشغيلها كل 8 ساعات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव एक्टिविटी को सिस्टम 8 घंटे बाद अपने आप समाप्त कर देता है — ऑटोमेशन उन्हें हर 8 घंटे में फिर से चालू कर देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity otomatis diakhiri oleh sistem setelah 8 jam — otomasi menyalakannya kembali setiap 8 jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity ditamatkan secara automatik oleh sistem selepas 8 jam — automasi menyalakannya semula setiap 8 jam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะปิด Live Activity โดยอัตโนมัติหลังผ่านไป 8 ชั่วโมง — ระบบอัตโนมัติจะเปิดขึ้นใหม่ทุก 8 ชั่วโมง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity sẽ tự động kết thúc sau 8 giờ theo hệ thống — tự động hóa sẽ bật lại sau mỗi 8 giờ."
          }
        }
      }
    },
