    "Under ‘Time of Day’, choose ‘Daily’ and ‘Run Immediately’.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘특정 시간’에서 ‘매일’, ‘즉시 실행’을 선택합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「時刻」で「毎日」と「すぐに実行」を選択します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“时刻”中选择“每天”和“立即运行”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「時刻」中選擇「每天」和「立即執行」。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ‘Hora del día’, elige ‘Cada día’ y ‘Ejecutar inmediatamente’."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em ‘Hora do dia’, escolha ‘Diariamente’ e ‘Executar imediatamente’."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ‘Ora del giorno’, scegli ‘Ogni giorno’ e ‘Esegui subito’."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle unter „Tageszeit“ die Optionen „Täglich“ und „Sofort ausführen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous « Heure de la journée », choisissez « Tous les jours » et « Exécuter immédiatement »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Время дня» выберите «Ежедневно» и «Выполнить сразу»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضمن ‘وقت اليوم’، اختر ‘يومياً’ و‘التشغيل فوراً’."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "‘समय’ के अंतर्गत ‘रोज़ाना’ और ‘तुरंत चलाएं’ चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di bagian ‘Waktu Hari’, pilih ‘Harian’ dan ‘Jalankan Segera’."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di bahagian ‘Masa Hari’, pilih ‘Harian’ dan ‘Jalankan Segera’."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใต้ ‘เวลาของวัน’ เลือก ‘รายวัน’ และ ‘เรียกใช้ทันที’"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong ‘Thời gian trong ngày’, chọn ‘Hằng ngày’ và ‘Chạy ngay’."
          }
        }
      }
    },
