    "If run times overlap with other automations, they may not run at the same time. Space them apart. e.g. 00:01, 08:01, 16:01": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 자동화와 실행 시각이 겹치면 동시에 실행되지 않을 수 있어요. 시간을 분리해 설정하세요. 예) 00:01, 08:01, 16:01"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のオートメーションと実行時刻が重なると、同時に実行されないことがあります。時刻を分けて設定してください。例）00:01、08:01、16:01"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果与其他自动化的运行时间重叠，可能无法同时运行。请错开时间设置。例如 00:01、08:01、16:01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若與其他自動化操作的執行時間重疊，可能無法同時執行。請錯開時間設定。例如 00:01、08:01、16:01"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si las horas de ejecución coinciden con otras automatizaciones, es posible que no se ejecuten al mismo tiempo. Sepáralas. Ej.: 00:01, 08:01, 16:01"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os horários de execução coincidirem com outras automações, elas podem não rodar ao mesmo tempo. Espace-as. Ex.: 00:01, 08:01, 16:01"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gli orari di esecuzione coincidono con altre automazioni, potrebbero non avviarsi insieme. Distanziali. Es.: 00:01, 08:01, 16:01"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich Ausführungszeiten mit anderen Automationen überschneiden, laufen sie evtl. nicht gleichzeitig. Verteile sie zeitlich. Z. B. 00:01, 08:01, 16:01"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les heures d'exécution chevauchent d'autres automatisations, elles peuvent ne pas s'exécuter en même temps. Espacez-les. Ex. 00:01, 08:01, 16:01"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если время запуска совпадает с другими автоматизациями, они могут не сработать одновременно. Разнесите их по времени. Напр., 00:01, 08:01, 16:01"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تداخلت أوقات التشغيل مع أتمتة أخرى، فقد لا تعمل في الوقت نفسه. باعِد بينها. مثال: 00:01، 08:01، 16:01"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर चलने का समय अन्य ऑटोमेशन से टकराता है, तो वे एक साथ नहीं चल सकते। उनमें अंतर रखें। जैसे 00:01, 08:01, 16:01"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika waktu jalan bertumpuk dengan otomasi lain, keduanya mungkin tidak jalan bersamaan. Beri jarak. mis. 00:01, 08:01, 16:01"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika masa jalan bertindih dengan automasi lain, ia mungkin tidak berjalan serentak. Jarakkan masanya. cth. 00:01, 08:01, 16:01"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเวลาทำงานทับซ้อนกับระบบอัตโนมัติอื่น อาจไม่ทำงานพร้อมกัน ให้เว้นระยะเวลาห่างกัน เช่น 00:01, 08:01, 16:01"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thời gian chạy trùng với tự động hóa khác, chúng có thể không chạy cùng lúc. Hãy giãn cách ra. VD: 00:01, 08:01, 16:01"
          }
        }
      }
    },
