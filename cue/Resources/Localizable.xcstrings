    "Turn on and refresh without the 2-per-day limit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 2회 제한 없이 켜고 새로고침"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日2回の制限なしでオンにして更新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启并刷新，不受每天 2 次限制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟並重新整理，不受每天 2 次限制"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa y actualiza sin el límite de 2 al día"
          }
        },
