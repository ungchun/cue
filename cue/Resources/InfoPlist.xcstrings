    "NSAlarmKitUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم للإعلان عن التبديل بين التركيز والاستراحة على شاشة القفل وDynamic Island في الوقت المحدد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Fokus- und Pausenwechsel zur exakten Zeit auf dem Sperrbildschirm und in der Dynamic Island anzukündigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to announce focus and break transitions on the Lock Screen and Dynamic Island at the exact time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para anunciar los cambios entre concentración y descanso en la pantalla bloqueada y la Dynamic Island a la hora exacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à annoncer les transitions entre concentration et pause sur l'écran verrouillé et la Dynamic Island à l'heure exacte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक स्क्रीन और Dynamic Island पर सही समय पर फ़ोकस और ब्रेक बदलाव की सूचना देने के लिए उपयोग होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memberi tahu pergantian fokus dan istirahat di Layar Terkunci dan Dynamic Island tepat waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve ad annunciare i passaggi tra concentrazione e pausa sulla schermata di blocco e nella Dynamic Island all'ora esatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中と休憩の切り替えを正確な時刻にロック画面とDynamic Islandでお知らせするために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중·휴식 단계 전환을 잠금화면과 다이나믹 아일랜드에 정확한 시각으로 알리기 위해 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memaklumkan pertukaran fokus dan rehat pada Skrin Kunci dan Dynamic Island pada masa yang tepat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para anunciar as transições entre foco e pausa na Tela Bloqueada e na Dynamic Island no horário exato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, чтобы точно вовремя сообщать о смене фокуса и перерыва на экране блокировки и в Dynamic Island."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อแจ้งการสลับระหว่างโหมดโฟกัสและพักบนหน้าจอล็อคและ Dynamic Island ตรงเวลา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để thông báo chuyển đổi giữa tập trung và nghỉ trên Màn hình khóa và Dynamic Island đúng giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在准确时间在锁定屏幕和灵动岛上提示专注与休息的切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在準確時間在鎖定畫面和動態島上提示專注與休息的切換。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Cue إلى الوصول لعرض أحداث تقويم iOS وإنشائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue benötigt Zugriff, um deine iOS-Kalenderereignisse anzuzeigen und zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue needs access to view and create your iOS Calendar events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue necesita acceso para ver y crear tus eventos del Calendario de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue a besoin d'accéder à votre Calendrier iOS pour afficher et créer des événements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS कैलेंडर इवेंट देखने और बनाने के लिए Cue को एक्सेस चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue memerlukan akses untuk melihat dan membuat acara Kalender iOS Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ha bisogno dell'accesso per visualizzare e creare gli eventi del Calendario di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSカレンダーの予定をCueで表示・作成するためにアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 캘린더 이벤트를 cue에서 보고 만들기 위해 접근이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue memerlukan akses untuk melihat dan mencipta acara Kalendar iOS anda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue precisa de acesso para ver e criar seus eventos do Calendário do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue требуется доступ, чтобы просматривать и создавать события Календаря iOS."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ต้องการสิทธิ์เข้าถึงเพื่อดูและสร้างกิจกรรมในปฏิทิน iOS ของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue cần quyền truy cập để xem và tạo sự kiện Lịch iOS của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 需要访问权限以查看和创建您的 iOS 日历日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 需要取用權限以查看和建立您的 iOS 行事曆行程。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Cue موقعك لإضافة موقعك الحالي إلى الحدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue verwendet deinen Standort, um deinen aktuellen Standort zu einem Ereignis hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue usa tu ubicación para añadir tu ubicación actual a un evento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue utilise votre position pour ajouter votre position actuelle à un événement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue आपके वर्तमान स्थान को इवेंट में जोड़ने के लिए आपके स्थान का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue menggunakan lokasi Anda untuk menambahkan lokasi saat ini ke acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue usa la tua posizione per aggiungere la posizione attuale a un evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueは現在地をイベントに追加するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 이벤트에 추가하기 위해 위치 정보를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue menggunakan lokasi anda untuk menambah lokasi semasa ke acara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue usa sua localização para adicionar a localização atual a um evento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue использует вашу геопозицию, чтобы добавить текущее местоположение в событие."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ใช้ตำแหน่งของคุณเพื่อเพิ่มตำแหน่งปัจจุบันลงในกิจกรรม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue dùng vị trí của bạn để thêm vị trí hiện tại vào sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 使用你的位置以将当前位置添加到日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 使用你的位置以將目前位置加入行程。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
