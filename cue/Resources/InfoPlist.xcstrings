        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue benötigt Zugriff, um deine iOS-Erinnerungen anzuzeigen und zu verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue needs access to view and manage your iOS Reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue necesita acceso para ver y gestionar tus Recordatorios de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue a besoin d'accéder à vos Rappels iOS pour les afficher et les gérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS रिमाइंडर देखने और प्रबंधित करने के लिए Cue को एक्सेस चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue memerlukan akses untuk melihat dan mengelola Pengingat iOS Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ha bisogno dell'accesso per visualizzare e gestire i tuoi Promemoria di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSリマインダーをCueで表示・管理するためにアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 미리 알림을 cue에서 보고 관리하기 위해 접근이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue memerlukan akses untuk melihat dan mengurus Peringatan iOS anda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue precisa de acesso para ver e gerenciar seus Lembretes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue требуется доступ, чтобы просматривать напоминания iOS и управлять ими."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ต้องการสิทธิ์เข้าถึงเพื่อดูและจัดการเตือนความจำ iOS ของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue cần quyền truy cập để xem và quản lý Lời nhắc iOS của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 需要访问权限以查看和管理您的 iOS 提醒事项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 需要取用權限以查看和管理您的 iOS 提醒事項。"
